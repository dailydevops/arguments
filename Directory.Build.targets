<Project>
  <!--
    NetEvolve.Defaults (a GlobalPackageReference, see Directory.Packages.props) sets
    GeneratePackageOnBuild=true for every packable project in this repo. The .NET SDK's own Pack
    target intentionally does NOT depend on Build in that case: GenerateNuspecDependsOn only gets
    "Build;" prepended when GeneratePackageOnBuild != true (see NuGet.Build.Tasks.Pack.targets /
    Microsoft.NET.Sdk.targets), because packaging is expected to happen automatically as a side
    effect of Build instead (via the SDK's own AfterTargets="Build" hook).

    That assumption breaks plain `dotnet pack` on a clean tree: nothing ever builds the project, so
    its own compiled output is missing on disk and packing fails (NU5026 for the project's own
    output, or NU5019 for referenced content that is also never built).


    Force a real build here, right before the pack pipeline starts collecting package content
    (_LoadPackInputItems is the very first step of GenerateNuspecDependsOn), using an explicit
    MSBuild invocation with a distinguishing global property. That makes it a different project
    instance than the one currently running Pack, so it is safe to call even while this project is
    already mid-Pack, and it does not interfere with `dotnet build` (GeneratePackageOnBuild's normal
    build-then-pack flow) or with the no-build flag (guarded by NoBuild below).

    For single-TargetFramework projects (no `TargetFrameworks` list), IsInnerBuild never becomes
    true, so the forced Build below would itself trigger the SDK's AfterTargets="Build" pack hook on
    that same distinguished instance, which would re-enter this very target. The
    `_EnsureBuildBeforePack` marker property (only ever set on that distinguished instance) breaks
    that re-entry immediately.
  -->
  <Target
    Name="_EnsureBuildBeforePack"
    BeforeTargets="_LoadPackInputItems"
    Condition=" '$(IsPackable)' == 'true' and '$(GeneratePackageOnBuild)' == 'true' and '$(NoBuild)' != 'true' and '$(_EnsureBuildBeforePack)' != 'true' "
  >
    <ItemGroup>
      <_PackSelfTargetFramework Include="$(TargetFrameworks)" Condition=" '$(TargetFrameworks)' != '' " />
    </ItemGroup>
    <MSBuild
      Projects="$(MSBuildProjectFullPath)"
      Targets="Build"
      Properties="Configuration=$(Configuration);TargetFramework=%(_PackSelfTargetFramework.Identity)"
      BuildInParallel="true"
      Condition=" '$(TargetFrameworks)' != '' "
    />
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="Build" Properties="Configuration=$(Configuration);_EnsureBuildBeforePack=true" Condition=" '$(TargetFrameworks)' == '' " />
  </Target>
</Project>
