{
  "stryker-config": {
    "solution": "Arguments.slnx",
    "mutation-level": "Advanced",
    "reporters": ["html", "json", "dashboard", "progress"],
    "project-info": { "name": "github.com/dailydevops/arguments" },
    "thresholds": { "high": 80, "low": 60, "break": 0 },
    "test-projects": [
      "tests/NetEvolve.Arguments.Analyser.Tests.Unit/NetEvolve.Arguments.Analyser.Tests.Unit.csproj",
      "tests/NetEvolve.Arguments.Tests.Unit/NetEvolve.Arguments.Tests.Unit.csproj"
    ],
    "coverage-analysis": "perTest",
    "mutate": ["**/*.cs", "!**/*.Designer.cs", "!**/*.g.cs", "!**/*.g.i.cs"],
    "test-runner": "mtp"
  }
}
